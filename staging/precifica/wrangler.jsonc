{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ever-precifica-integrated-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "services": [
    { "binding": "ACCESS_SERVICE", "service": "ever-tools-automation-staging" }
  ],
  "vars": { "ENVIRONMENT": "integrated-staging" }
}
